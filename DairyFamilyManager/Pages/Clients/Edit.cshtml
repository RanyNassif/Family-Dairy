@page
@model DairyFamilyManager.Pages.Clients.EditModel
@{
    ViewData["Title"] = "Edit Client";
}

<div class="dfm-pagehead mb-3">
    <div>
        <h1 class="dfm-h1 mb-1" data-i18n="label.editClient">Edit Client</h1>
        <div class="dfm-muted" data-i18n="label.clientsCreateSubtitle">Create a new client and set distributor behavior.</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <div>@Model.Error</div>
    </div>
}

<div class="dfm-card p-3">
    <form method="post" class="dfm-form">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label" data-i18n="label.nameEn">Name (EN)</label>
                <input class="form-control" name="NameEn" value="@Model.NameEn" />
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label" data-i18n="label.nameAr">Name (AR)</label>
                <input class="form-control" name="NameAr" value="@Model.NameAr" />
            </div>

            <div class="col-12">
                <div class="d-flex flex-wrap gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="UsesDistributor" checked="@(Model.UsesDistributor)" id="UsesDistributor" />
                        <label class="form-check-label" for="UsesDistributor" data-i18n="label.deliveredByDistributor">Delivered by distributor</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsActive" checked="@(Model.IsActive)" id="IsActive" />
                        <label class="form-check-label" for="IsActive" data-i18n="label.active">Active</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-secondary" href="/Clients"><i class="bi bi-x"></i><span data-i18n="action.cancel">Cancel</span></a>
            <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i><span data-i18n="action.save">Save</span></button>
        </div>
    </form>
</div>
