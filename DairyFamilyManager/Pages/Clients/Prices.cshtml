@page
@model DairyFamilyManager.Pages.Clients.PricesModel
@{
    ViewData["Title"] = "Client Prices";
}

<div class="dfm-pagehead mb-3">
    <div>
        <h1 class="dfm-h1 mb-1" data-i18n="label.clientPricesTitle">Client Prices</h1>
        <div class="dfm-muted" data-i18n="label.savePricesHelp">Update custom prices for this client.</div>
    </div>
</div>

@if (Model.Client == null)
{
    <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-info-circle"></i>
        <div data-i18n="label.clientNotFound">Client not found.</div>
    </div>
    <a class="btn btn-outline-secondary" href="/Clients"><i class="bi bi-arrow-left"></i><span data-i18n="action.back">Back</span></a>
    return;
}

<div class="dfm-card p-3 mb-3">
    <div class="fw-semibold">
        <span data-i18n="label.client">Client</span>:
        <span>@Model.Client.NameEn / @Model.Client.NameAr</span>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-check-circle"></i>
        <div>@Model.Message</div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <div>@Model.Error</div>
    </div>
}

<div class="dfm-card p-0">
    <form method="post">
        <input type="hidden" name="ClientId" value="@Model.Client.Id" />

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 dfm-table">
                <thead>
                    <tr>
                        <th data-i18n="label.productEn">Product (EN)</th>
                        <th data-i18n="label.productAr">Product (AR)</th>
                        <th data-i18n="label.basePriceShort">Base Price</th>
                        <th data-i18n="label.customPrice">Custom Price (leave empty to use base)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Rows.Count; i++)
                    {
                        <tr>
                            <td>@Model.Rows[i].ProductNameEn</td>
                            <td>@Model.Rows[i].ProductNameAr</td>
                            <td>@Model.Rows[i].BasePrice</td>
                            <td>
                                <input type="hidden" name="Rows[@i].ProductId" value="@Model.Rows[i].ProductId" />
                                <input class="form-control" name="Rows[@i].CustomPriceText" value="@Model.Rows[i].CustomPriceText" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end gap-2 p-3 border-top">
            <a class="btn btn-outline-secondary" href="/Clients"><i class="bi bi-arrow-left"></i><span data-i18n="action.back">Back</span></a>
            <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i><span data-i18n="action.savePrices">Save Prices</span></button>
        </div>
    </form>
</div>
