<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Dairy Family Manager</title>

    <script>
        (function () {
            const lang = localStorage.getItem('dfmLang') || 'en';
            document.documentElement.lang = lang;
            document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800&family=Inter:wght@400;600;800&display=swap" rel="stylesheet" />

    <link id="bsLtr" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link id="bsRtl" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" disabled />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="dfm-body dfm-auth">

    <div class="dfm-auth-shell">
        <div class="dfm-auth-brand">
            <div class="dfm-logo dfm-logo-lg">DF</div>
            <div class="dfm-auth-brand-text">
                <div class="dfm-auth-title">Dairy Family Manager</div>
                <div class="dfm-auth-subtitle">Daily sales • profits • costs</div>
            </div>
        </div>

        <div class="dfm-auth-card">
            @RenderBody()
        </div>

        <div class="dfm-auth-footer">© @DateTime.Today.Year Dairy Family Manager</div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const lang = localStorage.getItem('dfmLang') || 'en';
            const isRtl = lang === 'ar';

            const ltr = document.getElementById('bsLtr');
            const rtl = document.getElementById('bsRtl');
            if (ltr && rtl) {
                ltr.disabled = isRtl;
                rtl.disabled = !isRtl;
            }

            document.body.classList.toggle('dfm-rtl', isRtl);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
