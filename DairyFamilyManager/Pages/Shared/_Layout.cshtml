<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Dairy Family Manager</title>

    <script>
        (function () {
            const lang = localStorage.getItem('dfmLang') || 'en';
            document.documentElement.lang = lang;
            document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800&family=Inter:wght@400;600;800&display=swap" rel="stylesheet" />

    <link id="bsLtr" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link id="bsRtl" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" disabled />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body class="dfm-body">

@{
    string currentPath = Context.Request.Path.Value ?? string.Empty;
    bool isActive(string href)
    {
        if (string.IsNullOrWhiteSpace(href)) return false;
        if (href == "/") return currentPath == "/";

        bool exact = string.Equals(currentPath, href, StringComparison.OrdinalIgnoreCase);
        bool isChild = currentPath.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
        return exact || isChild;
    }
}

    <header class="dfm-topbar border-bottom">
        <div class="dfm-topbar-left">
            <button class="btn btn-sm btn-light dfm-sidebar-toggle" type="button" onclick="dfmToggleSidebar()" aria-label="Toggle menu">
                <i class="bi bi-list"></i>
            </button>
            <div class="dfm-brand">
                <div class="dfm-logo">DF</div>
                <div class="dfm-brand-text">
                    <div class="dfm-title">Dairy Family Manager</div>
                    <div class="dfm-subtitle">Daily sales • profits • costs</div>
                </div>
            </div>
        </div>

        <div class="dfm-topbar-right">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="dfm-user">
                    <div class="dfm-user-name">@User.Identity.Name</div>
                    <div class="dfm-user-role">@((User.IsInRole("Admin")) ? "Admin" : "Data Entry")</div>
                </div>

                <a class="btn btn-sm btn-outline-secondary" href="/Logout">Logout</a>
            }
        </div>
    </header>

    <div class="dfm-shell">
        <div class="dfm-sidebar-backdrop" onclick="dfmToggleSidebar(false)"></div>
        <aside class="dfm-sidebar border-end" id="dfmSidebar">
            <div class="dfm-nav">
                <a class="dfm-nav-item @(isActive("/Home") ? "active" : "")" href="/Home"><i class="bi bi-house"></i><span>Home</span></a>
                <a class="dfm-nav-item @(isActive("/Sales/Entry") ? "active" : "")" href="/Sales/Entry"><i class="bi bi-pencil-square"></i><span>Daily Entry</span></a>
                <a class="dfm-nav-item @(isActive("/Sales/Summary") ? "active" : "")" href="/Sales/Summary"><i class="bi bi-table"></i><span>Daily Summary</span></a>

                @if (User.IsInRole("Admin"))
                {
                    <div class="dfm-nav-section">Setup</div>
                    <a class="dfm-nav-item @(isActive("/Products") ? "active" : "")" href="/Products"><i class="bi bi-box-seam"></i><span>Products</span></a>
                    <a class="dfm-nav-item @(isActive("/Clients") ? "active" : "")" href="/Clients"><i class="bi bi-people"></i><span>Clients</span></a>
                    <a class="dfm-nav-item @(isActive("/Costs/Monthly") ? "active" : "")" href="/Costs/Monthly"><i class="bi bi-receipt"></i><span>Monthly Costs</span></a>

                    <div class="dfm-nav-section">Reports</div>
                    <a class="dfm-nav-item @(isActive("/Reports/Monthly") ? "active" : "")" href="/Reports/Monthly"><i class="bi bi-bar-chart"></i><span>Monthly Dashboard</span></a>
                }
            </div>

            <div class="dfm-sidebar-footer">
                <button class="btn btn-sm btn-light w-100" type="button" onclick="dfmToggleLang()">English / عربي</button>
            </div>
        </aside>

        <main class="dfm-content">
            <div class="container-fluid py-3">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function dfmToggleSidebar(forceOpen) {
            const shell = document.querySelector('.dfm-shell');
            if (!shell) return;

            const shouldOpen = typeof forceOpen === 'boolean' ? forceOpen : !shell.classList.contains('sidebar-open');
            shell.classList.toggle('sidebar-open', shouldOpen);
        }

        function dfmToggleLang() {
            const current = localStorage.getItem('dfmLang') || 'en';
            const next = current === 'en' ? 'ar' : 'en';
            localStorage.setItem('dfmLang', next);
            const culture = next === 'ar' ? 'ar-LB' : 'en-US';
            const returnUrl = encodeURIComponent(location.pathname + location.search);
            location.href = `/Lang?culture=${culture}&returnUrl=${returnUrl}`;
        }

        (function () {
            const lang = localStorage.getItem('dfmLang') || 'en';
            const isRtl = lang === 'ar';

            const ltr = document.getElementById('bsLtr');
            const rtl = document.getElementById('bsRtl');
            if (ltr && rtl) {
                ltr.disabled = isRtl;
                rtl.disabled = !isRtl;
            }

            document.body.classList.toggle('dfm-rtl', lang === 'ar');
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
