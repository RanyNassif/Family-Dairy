@page
@model DairyFamilyManager.Pages.Costs.MonthlyModel
@{
    ViewData["Title"] = "Monthly Costs";
}

<h2>Monthly Costs</h2>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div style="color:red">@Model.Error</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div style="color:green">@Model.Message</div>
}

<form method="get">
    <label>Year</label><br />
    <input name="year" value="@Model.Year" />

    <div style="margin-top:10px;">
        <label>Month (1-12)</label><br />
        <input name="month" value="@Model.Month" />
    </div>

    <div style="margin-top:10px;">
        <button type="submit">Load</button>
    </div>
</form>

<hr />

<form method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="Year" value="@Model.Year" />
    <input type="hidden" name="Month" value="@Model.Month" />

    <table border="1" cellpadding="6" cellspacing="0">
        <thead>
            <tr>
                <th>Product (EN)</th>
                <th>Product (AR)</th>
                <th>Milk</th>
                <th>Workers</th>
                <th>Gas</th>
                <th>Other</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Rows.Count; i++)
            {
                <tr>
                    <td>@Model.Rows[i].ProductNameEn</td>
                    <td>@Model.Rows[i].ProductNameAr</td>

                    <td>
                        <input type="hidden" name="Rows[@i].ProductId" value="@Model.Rows[i].ProductId" />
                        <input name="Rows[@i].MilkCostText" value="@Model.Rows[i].MilkCostText" />
                    </td>

                    <td><input name="Rows[@i].WorkersCostText" value="@Model.Rows[i].WorkersCostText" /></td>
                    <td><input name="Rows[@i].GasCostText" value="@Model.Rows[i].GasCostText" /></td>
                    <td><input name="Rows[@i].OtherCostText" value="@Model.Rows[i].OtherCostText" /></td>
                </tr>
            }
        </tbody>
    </table>

    <div style="margin-top:15px;">
        <button type="submit">Save</button>
    </div>
</form>
