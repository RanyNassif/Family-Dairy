@page
@model DairyFamilyManager.Pages.Sales.SummaryModel
@{
    ViewData["Title"] = "Daily Summary";
}

<div class="dfm-pagehead mb-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="dfm-h1 mb-1" data-i18n="nav.dailySummary">Daily Summary</h1>
            <div class="dfm-muted" data-i18n="label.dailySummarySubtitle">Totals and breakdowns for the selected date.</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <div>@Model.Error</div>
    </div>
}

<div class="dfm-card p-3 mb-3">
    <form method="get" class="row g-3 align-items-end dfm-form">
        <div class="col-12 col-md-4">
            <label class="form-label" data-i18n="label.date">Date</label>
            <input class="form-control" type="date" name="DateString" value="@Model.DateString" />
        </div>

        <div class="col-12 col-md-2 d-grid">
            <button class="btn btn-primary dfm-btn-lg" type="submit"><i class="bi bi-arrow-repeat"></i><span data-i18n="action.load">Load</span></button>
        </div>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-lg-3">
        <div class="dfm-kpi">
            <div class="label" data-i18n="label.totalSales">Total Sales</div>
            <div class="value">@Model.TotalSales</div>
        </div>
    </div>
    <div class="col-12 col-lg-3">
        <div class="dfm-kpi">
            <div class="label" data-i18n="label.factoryProfit">Factory Profit</div>
            <div class="value">@Model.TotalFactoryProfit</div>
        </div>
    </div>
    <div class="col-12 col-lg-3">
        <div class="dfm-kpi">
            <div class="label" data-i18n="label.distributorProfit">Distributor Profit</div>
            <div class="value">@Model.TotalDistributorProfit</div>
        </div>
    </div>
    <div class="col-12 col-lg-3">
        <div class="dfm-kpi">
            <div class="label" data-i18n="label.distributorNetAfterBenzine">Distributor Net (after benzine)</div>
            <div class="value">@Model.DistributorNet</div>
        </div>
    </div>
</div>

<div class="dfm-card p-3 mb-3">
    <form method="post" class="row g-3 align-items-end dfm-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="DateString" value="@Model.DateString" />

        <div class="col-12 col-md-4">
            <label class="form-label" data-i18n="label.benzine">Benzine (Distributor daily expense)</label>
            <input class="form-control" name="BenzineText" value="@Model.BenzineText" />
            <div class="form-text" data-i18n="label.saveBenzineHelp">This will be used to compute distributor net for the day.</div>
        </div>

        <div class="col-12 col-md-2 d-grid">
            <button class="btn btn-outline-primary dfm-btn-lg" type="submit"><i class="bi bi-save"></i><span data-i18n="action.save">Save</span></button>
        </div>
    </form>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-6">
        <div class="dfm-card p-0">
            <div class="px-3 py-3 border-bottom">
                <div class="fw-bold" data-i18n="label.byClient">By Client</div>
                <div class="dfm-muted" style="font-size:13px;" data-i18n="label.byClientSubtitle">Sales and profits per client.</div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 dfm-table">
                    <thead>
                        <tr>
                            <th data-i18n="label.clientEn">Client (EN)</th>
                            <th data-i18n="label.clientAr">Client (AR)</th>
                            <th data-i18n="label.distributor">Distributor</th>
                            <th class="text-end" data-i18n="label.sales">Sales</th>
                            <th class="text-end" data-i18n="label.factoryProfit">Factory Profit</th>
                            <th class="text-end" data-i18n="label.distributorProfit">Distributor Profit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ByClient)
                        {
                            <tr>
                                <td class="fw-semibold">@r.ClientNameEn</td>
                                <td>@r.ClientNameAr</td>
                                <td>
                                    @if (r.UsesDistributor)
                                    {
                                        <span class="badge text-bg-primary" data-i18n="label.yes">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary" data-i18n="label.no">No</span>
                                    }
                                </td>
                                <td class="text-end">@r.SalesTotal</td>
                                <td class="text-end">@r.FactoryProfitTotal</td>
                                <td class="text-end">@r.DistributorProfitTotal</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="dfm-card p-0">
            <div class="px-3 py-3 border-bottom">
                <div class="fw-bold" data-i18n="label.byProduct">By Product</div>
                <div class="dfm-muted" style="font-size:13px;" data-i18n="label.byProductSubtitle">Quantity, sales, and profits per product.</div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 dfm-table">
                    <thead>
                        <tr>
                            <th data-i18n="label.productEn">Product (EN)</th>
                            <th data-i18n="label.productAr">Product (AR)</th>
                            <th class="text-end" data-i18n="label.qty">Qty</th>
                            <th class="text-end" data-i18n="label.sales">Sales</th>
                            <th class="text-end" data-i18n="label.factoryProfit">Factory Profit</th>
                            <th class="text-end" data-i18n="label.distributorProfit">Distributor Profit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ByProduct)
                        {
                            <tr>
                                <td class="fw-semibold">@r.ProductNameEn</td>
                                <td>@r.ProductNameAr</td>
                                <td class="text-end">@r.QuantityTotal</td>
                                <td class="text-end">@r.SalesTotal</td>
                                <td class="text-end">@r.FactoryProfitTotal</td>
                                <td class="text-end">@r.DistributorProfitTotal</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
