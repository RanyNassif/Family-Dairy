@page
@model DairyFamilyManager.Pages.Sales.SummaryModel
@{
    ViewData["Title"] = "Daily Summary";
}

<div class="dfm-pagehead mb-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="dfm-h1 mb-1">Daily Summary</h1>
            <div class="dfm-muted">Totals and breakdowns for the selected date.</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <div>@Model.Error</div>
    </div>
}

<div class="dfm-card p-3 mb-3">
    <form method="get" class="row g-3 align-items-end dfm-form">
        <div class="col-12 col-md-4">
            <label class="form-label">Date</label>
            <input class="form-control" type="date" name="DateString" value="@Model.DateString" />
        </div>

        <div class="col-12 col-md-2 d-grid">
            <button class="btn btn-primary dfm-btn-lg" type="submit"><i class="bi bi-arrow-repeat"></i><span>Load</span></button>
        </div>
    </form>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-lg-3">
        <div class="dfm-kpi">
            <div class="label">Total Sales</div>
            <div class="value">@Model.TotalSales</div>
        </div>
    </div>
    <div class="col-12 col-lg-3">
        <div class="dfm-kpi">
            <div class="label">Factory Profit</div>
            <div class="value">@Model.TotalFactoryProfit</div>
        </div>
    </div>
    <div class="col-12 col-lg-3">
        <div class="dfm-kpi">
            <div class="label">Distributor Profit</div>
            <div class="value">@Model.TotalDistributorProfit</div>
        </div>
    </div>
    <div class="col-12 col-lg-3">
        <div class="dfm-kpi">
            <div class="label">Distributor Net (after benzine)</div>
            <div class="value">@Model.DistributorNet</div>
        </div>
    </div>
</div>

<div class="dfm-card p-3 mb-3">
    <form method="post" class="row g-3 align-items-end dfm-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="DateString" value="@Model.DateString" />

        <div class="col-12 col-md-4">
            <label class="form-label">Benzine (Distributor daily expense)</label>
            <input class="form-control" name="BenzineText" value="@Model.BenzineText" />
            <div class="form-text">This will be used to compute distributor net for the day.</div>
        </div>

        <div class="col-12 col-md-2 d-grid">
            <button class="btn btn-outline-primary dfm-btn-lg" type="submit"><i class="bi bi-save"></i><span>Save</span></button>
        </div>
    </form>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-6">
        <div class="dfm-card p-0">
            <div class="px-3 py-3 border-bottom">
                <div class="fw-bold">By Client</div>
                <div class="dfm-muted" style="font-size:13px;">Sales and profits per client.</div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 dfm-table">
                    <thead>
                        <tr>
                            <th>Client (EN)</th>
                            <th>Client (AR)</th>
                            <th>Distributor</th>
                            <th class="text-end">Sales</th>
                            <th class="text-end">Factory Profit</th>
                            <th class="text-end">Distributor Profit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ByClient)
                        {
                            <tr>
                                <td class="fw-semibold">@r.ClientNameEn</td>
                                <td>@r.ClientNameAr</td>
                                <td>
                                    @if (r.UsesDistributor)
                                    {
                                        <span class="badge text-bg-primary">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">No</span>
                                    }
                                </td>
                                <td class="text-end">@r.SalesTotal</td>
                                <td class="text-end">@r.FactoryProfitTotal</td>
                                <td class="text-end">@r.DistributorProfitTotal</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-6">
        <div class="dfm-card p-0">
            <div class="px-3 py-3 border-bottom">
                <div class="fw-bold">By Product</div>
                <div class="dfm-muted" style="font-size:13px;">Quantity, sales, and profits per product.</div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 dfm-table">
                    <thead>
                        <tr>
                            <th>Product (EN)</th>
                            <th>Product (AR)</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Sales</th>
                            <th class="text-end">Factory Profit</th>
                            <th class="text-end">Distributor Profit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ByProduct)
                        {
                            <tr>
                                <td class="fw-semibold">@r.ProductNameEn</td>
                                <td>@r.ProductNameAr</td>
                                <td class="text-end">@r.QuantityTotal</td>
                                <td class="text-end">@r.SalesTotal</td>
                                <td class="text-end">@r.FactoryProfitTotal</td>
                                <td class="text-end">@r.DistributorProfitTotal</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
