@page
@model DairyFamilyManager.Pages.Sales.EntryModel
@{
    ViewData["Title"] = "Daily Entry";
}

<div class="dfm-pagehead mb-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="dfm-h1 mb-1">Daily Sales Entry</h1>
            <div class="dfm-muted">Pick a date and client, then add sold products and prices.</div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-exclamation-triangle"></i>
        <div>@Model.Error</div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success d-flex align-items-start gap-2" role="alert">
        <i class="bi bi-check-circle"></i>
        <div>@Model.Message</div>
    </div>
}

<div class="dfm-card p-3 mb-3">
    <form method="get" class="row g-3 align-items-end dfm-form">
        <div class="col-12 col-md-4">
            <label class="form-label">Date</label>
            <input class="form-control" type="date" name="date" value="@Model.DateString" />
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label">Client</label>
            <select class="form-select" name="clientId">
                <option value="">-- Select client --</option>
                @foreach (var c in Model.ClientOptions)
                {
                    <option value="@c.Id" selected="@(Model.ClientId == c.Id)">@c.NameEn</option>
                }
            </select>
        </div>

        <div class="col-12 col-md-2 d-grid">
            <button class="btn btn-primary dfm-btn-lg" type="submit"><i class="bi bi-arrow-repeat"></i><span>Load</span></button>
        </div>
    </form>
</div>

@if (Model.ClientId > 0)
{
    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-4">
            <div class="dfm-kpi">
                <div class="label">Total Sales</div>
                <div class="value">@Model.TotalSales</div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="dfm-kpi">
                <div class="label">Factory Profit</div>
                <div class="value">@Model.TotalFactoryProfit</div>
            </div>
        </div>
        @if (Model.ClientUsesDistributor)
        {
            <div class="col-12 col-lg-4">
                <div class="dfm-kpi">
                    <div class="label">Distributor Profit</div>
                    <div class="value">@Model.TotalDistributorProfit</div>
                </div>
            </div>
        }
    </div>

    <div class="dfm-card p-0">
        <div class="d-flex align-items-center justify-content-between px-3 py-3 border-bottom flex-wrap gap-2">
            <div>
                <div class="fw-bold">Lines</div>
                <div class="dfm-muted" style="font-size:13px;">Add the products sold for the selected client.</div>
            </div>
        </div>

        <form method="post" class="p-3">
            @Html.AntiForgeryToken()

            <input type="hidden" name="DateString" value="@Model.DateString" />
            <input type="hidden" name="ClientId" value="@Model.ClientId" />

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 dfm-table">
                    <thead>
                        <tr>
                            <th style="min-width:260px;">Product</th>
                            <th style="width:140px;">Qty</th>
                            <th style="width:180px;">Unit Price</th>
                            <th style="width:220px;" class="text-center">Save price as default</th>
                            <th style="width:110px;" class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Lines.Count; i++)
                        {
                            <tr>
                                <td>
                                    <select class="form-select" name="Lines[@i].ProductId">
                                        <option value="">-- Select product --</option>
                                        @foreach (var p in Model.ProductOptions)
                                        {
                                            <option value="@p.Id" selected="@(Model.Lines[i].ProductId == p.Id)">@p.NameEn</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input class="form-control" name="Lines[@i].Quantity" value="@Model.Lines[i].QuantityText" />
                                </td>
                                <td>
                                    <input class="form-control" name="Lines[@i].UnitPrice" value="@Model.Lines[i].UnitPriceText" />
                                </td>
                                <td class="text-center">
                                    <div class="form-check d-inline-flex align-items-center gap-2">
                                        <input class="form-check-input" type="checkbox" name="Lines[@i].SaveAsDefault" checked="@(Model.Lines[i].SaveAsDefault)" />
                                        <label class="form-check-label dfm-muted">Remember</label>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" name="removeIndex" value="@i"><i class="bi bi-trash"></i><span>Remove</span></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                <div class="dfm-muted" style="font-size:13px;">
                    Tip: use “Save price as default” to store client-specific default prices.
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" type="submit" name="action" value="add"><i class="bi bi-plus"></i><span>Add line</span></button>
                    <button class="btn btn-primary" type="submit" name="action" value="save"><i class="bi bi-check2"></i><span>Save</span></button>
                </div>
            </div>
        </form>
    </div>
}
